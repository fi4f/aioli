; Filesystem policy is editable Lisp. Storage only commits key/value operations.
(let normalize (fn (path)
  (Resources.require (and (str? path) (Strings.starts path "/") (Strings.clean path)) "Expected an absolute slash-separated path")
  (let parts (list))
  (for part (Strings.split path "/") {
    (if (or (= part "") (= part ".")) (continue))
    (if (= part "..") {
      (Resources.require (> (len parts) 0) "Path escapes the filesystem root")
      (remove parts (- (len parts) 1))
    } else (insert parts part))
  })
  $"/{(Strings.join parts "/")}"))
(let parent (fn (path)
  (set path (normalize path))
  (let end (Strings.lastIndex path "/"))
  (if (= end 0) "/" (Strings.slice path 0 end))))
(let name (fn (path)
  (set path (normalize path))
  (if (= path "/") "/" (Strings.slice path (+ (Strings.lastIndex path "/") 1) nil))))
(let extension (fn (path)
  (let base (name path)) (let dot (Strings.lastIndex base "."))
  (if (< dot 0) "" (Strings.lower (Strings.slice base dot nil)))))
(let contains (fn (directory path)
  (set directory (normalize directory)) (set path (normalize path))
  (or (= directory "/") (= directory path) (Strings.starts path $"{directory}/"))))
(let rebase (fn (path from to)
  (set path (normalize path)) (set from (normalize from)) (set to (normalize to))
  (if (contains from path) (normalize $"{to}{(Strings.slice path (if (= from "/") 0 (len from)) nil)}") path)))
(let join (fn (directory child)
  (Resources.require (and (str? child) (not (= child "")) (Strings.clean child)
    (not (Strings.has child "/")) (not (= child ".")) (not (= child ".."))) "Enter a single file or folder name")
  (normalize $"{directory}/{child}")))
(let __entry__ (fn (path kind revision)
  (dict "path" path "name" (name path) "kind" kind "revision" revision "size" 0 "modified" (Resources.now))))
(let __put-op__ (fn (ops key value) (insert ops (dict "kind" "put" "key" key "value" value))))
(let __remove-op__ (fn (ops key) (insert ops (dict "kind" "remove" "key" key))))
(let __ensure__ (fn (entries ops directory)
  (if (in directory entries) {
    (Resources.require (= (get entries.(get directory)).kind "directory") $"Not a directory: {directory}")
    (return)
  })
  (__ensure__ entries ops (parent directory))
  (put entries directory (__entry__ directory "directory" 1))))
(let new (async (fn (storage local-url base-url)
  (let records (await (Storage.records storage)))
  (let entries (or records.index (dict "/" (__entry__ "/" "directory" 1))))
  (let contents (dict))
  (for key (keys records) (if (Strings.starts key "file:")
    (put contents (Strings.slice key 5 nil) (get records.(get key)))))
  (let valid (dict? entries))
  (if valid (for path (keys entries) {
    (let entry (get entries.(get path)))
    (if (or (not (dict? entry)) (not (str? entry.name)) (not (in entry.kind (list "file" "directory"))))
      (set valid false))
  }))
  (if (or (not valid) (not (in "/" entries))) {
    ; Recovery can reconstruct metadata without executing the project's VFS.
    (set entries (dict "/" (__entry__ "/" "directory" 1)))
    (let ops (list))
    (for path (keys contents) {
      (if (not (and (str? path) (Strings.starts path "/") (Strings.clean path))) (continue))
      (let resource (get contents.(get path)))
      (__ensure__ entries ops (parent path))
      (let entry (__entry__ path "file" 1))
      (set entry.mime (if (and (dict? resource) (str? resource.mime)) resource.mime "application/octet-stream"))
      (set entry.size (if (and (dict? resource) (= (type resource.size) "__num__")) resource.size 0))
      (set entry.text (or (Strings.starts entry.mime "text/") (in (extension path) (list ".lisp" ".js" ".json" ".txt" ".svg"))))
      (set entry.image (Strings.starts entry.mime "image/"))
      (put entries path entry)
    })
  })
  (dict "storage" storage "entries" entries "__contents__" contents "version" storage.version
    "baseURL" base-url "localURL" local-url "project" (if (dict? records.project) records.project (dict)) "__tail__" (promise nil)))))
(let stat (fn (fs path)
  (let entry (get fs.entries.(normalize path))) (if entry (copy entry) nil)))
(let listFiles (fn (fs directory)
  (if (= directory nil) (set directory "/"))
  (set directory (normalize directory))
  (Resources.require (= (get fs.entries.(get directory)).kind "directory") $"Directory does not exist: {directory}")
  (let folders (list)) (let files (list))
  (for path (Strings.sorted (keys fs.entries)) {
    (if (or (= path "/") (not (= (parent path) directory))) (continue))
    (let entry (copy (get fs.entries.(get path))))
    (insert (if (= entry.kind "directory") folders files) entry)
  })
  (for file files (insert folders file)) folders))
(let __mutate__ (fn (fs work)
  ; Promise bodies run later. Capture the prior tail before publishing this operation.
  (let previous fs.__tail__)
  (let result (promise previous then () {
    (let entries (copy fs.entries)) (let contents (copy fs.__contents__)) (let ops (list))
    (let result (work entries contents ops))
    (__put-op__ ops "index" entries)
    (let version (await (Storage.commit fs.storage fs.version ops)))
    (set fs.entries entries) (set fs.__contents__ contents) (set fs.version version)
    result
  }))
  (set fs.__tail__ (promise result catch () nil)) result))
(let __write__ (fn (entries contents ops path resource is-text revision)
  (set path (normalize path))
  (Resources.validate resource)
  (let previous (get entries.(get path)))
  (Resources.require (not (and previous (= previous.kind "directory"))) $"Cannot replace a directory: {path}")
  (if (not (= revision nil))
    (Resources.require (= revision (if previous previous.revision 0)) $"File changed since it was opened: {path}"))
  (Resources.require (= (get entries.(parent path)).kind "directory") $"Parent directory does not exist: {path}")
  (let entry (__entry__ path "file" (+ (if previous previous.revision 0) 1)))
  (set entry.size resource.size) (set entry.mime resource.mime) (set entry.text is-text)
  (set entry.image (Strings.starts resource.mime "image/"))
  (put entries path entry) (put contents path resource) (__put-op__ ops $"file:{path}" resource)
  (copy entry)))
(let readText (async (fn (fs path)
  (await fs.__tail__) (set path (normalize path))
  (let entry (stat fs path))
  (Resources.require (and entry (= entry.kind "file") entry.text) $"Text file does not exist: {path}")
  (Resources.text (get fs.__contents__.(get path))))))
(let readBytes (async (fn (fs path)
  (await fs.__tail__) (set path (normalize path))
  (Resources.require (= (stat fs path).kind "file") $"File does not exist: {path}")
  (Resources.bytes (get fs.__contents__.(get path))))))
(let writeText (fn (fs path content revision)
  (__mutate__ fs (fn (entries contents ops)
    (__write__ entries contents ops path (Resources.fromText content "text/plain;charset=utf-8") true revision)))))
(let writeBytes (fn (fs path bytes mime revision)
  (__mutate__ fs (fn (entries contents ops)
    (__write__ entries contents ops path (Resources.fromBytes bytes (or mime "application/octet-stream")) false revision)))))
(let mkdir (fn (fs path)
  (__mutate__ fs (fn (entries contents ops) {
    (set path (normalize path)) (Resources.require (not (in path entries)) $"Path already exists: {path}")
    (Resources.require (= (get entries.(parent path)).kind "directory") "Parent directory does not exist")
    (let entry (__entry__ path "directory" 1)) (put entries path entry) (return (copy entry))
  }))))
(let __remove__ (fn (fs path recursive)
  (__mutate__ fs (fn (entries contents ops) {
    (set path (normalize path))
    (Resources.require (and (not (= path "/")) (in path entries)) "Cannot remove this path")
    (for key (keys entries) {
      (if (not (contains path key)) (continue))
      (Resources.require (or recursive (= key path)) "Directory is not empty")
      (remove-key entries key) (remove-key contents key) (__remove-op__ ops $"file:{key}")
    }) (return path)
  }))))
(let removeFile (fn (fs path) (__remove__ fs path false)))
(let removeTree (fn (fs path) (__remove__ fs path true)))
(let move (fn (fs from to)
  (__mutate__ fs (fn (entries contents ops) {
    (set from (normalize from)) (set to (normalize to))
    (Resources.require (and (not (= from "/")) (in from entries) (not (in to entries))
      (not (contains from to)) (= (get entries.(parent to)).kind "directory")) "Invalid move")
    (for path (keys entries) {
      (if (not (contains from path)) (continue))
      (let next (rebase path from to)) (let entry (copy (get entries.(get path))))
      (set entry.path next) (set entry.name (name next)) (set entry.modified (Resources.now))
      (put entries next entry) (remove-key entries path)
      (if (= entry.kind "file") {
        (let resource (get contents.(get path)))
        (put contents next resource) (remove-key contents path)
        (__put-op__ ops $"file:{next}" resource) (__remove-op__ ops $"file:{path}")
      })
    }) (return (copy (get entries.(get to))))
  }))))
(let refresh (async (fn (fs)
  (await fs.__tail__)
  (let current (await (new fs.storage fs.localURL fs.baseURL)))
  (set fs.entries current.entries) (set fs.version current.version)
  (set fs.project current.project) (set fs.__contents__ current.__contents__)
  fs)))
(let __encoded__ (fn (path)
  (let parts (list))
  (for part (Strings.split (normalize path) "/") (insert parts (Strings.encode part)))
  (Strings.join parts "/")))
(let url (fn (fs path) (Resources.resolve (__encoded__ path) fs.baseURL)))
(let ownsURL (fn (fs reference) (Resources.owns reference fs.baseURL)))
(let fetch (async (fn (fs reference options)
  (if (not (ownsURL fs reference)) (return (await (Resources.fetch reference))))
  (await fs.__tail__)
  (let path (normalize (Resources.path reference)))
  (if (= path "/hg/ui.lisp") (set path "/editor/ui.lisp"))
  (let entry (stat fs path))
  (if entry {
    (Resources.require (= entry.kind "file") $"Not a file: {path}")
    (return (get fs.__contents__.(get path)))
  })
  (let resource (await (Resources.fetch (Resources.resolve (Strings.slice (__encoded__ path) 1 nil) fs.localURL))))
  (if resource.ok {
    (let is-text (or (Strings.starts resource.mime "text/") (in (extension path) (list ".lisp" ".js" ".json" ".txt" ".svg"))))
    (await (__mutate__ fs (fn (entries contents ops) {
      (__ensure__ entries ops (parent path))
      ; An intervening write wins over a fetched fallback.
      (if (not (in path entries)) (__write__ entries contents ops path resource is-text 0))
    })))
    (return (get fs.__contents__.(get path)))
  }) resource)))
(let importFiles (fn (fs directory files)
  (__mutate__ fs (fn (entries contents ops) {
    (set directory (normalize directory))
    (let target (get entries.(get directory)))
    (Resources.require (and target (= target.kind "directory")) "Import destination must be an existing folder")
    (let imported (list)) (let seen (dict))
    (for file files {
      ; Each browser-supplied path is relative, with no aliases or traversal.
      (let path directory)
      (for part (Strings.split file.path "/") (set path (join path part)))
      (Resources.require (not (in path seen)) $"Duplicate imported path: {path}")
      (put seen path true)
      (Resources.require (in file.kind (list "file" "directory")) "Invalid imported entry")
      (if (= file.kind "directory") (__ensure__ entries ops path) else {
        (Resources.require (not (in path entries)) $"Path already exists: {path}")
        (__ensure__ entries ops (parent path))
        (let resource file.resource)
        (Resources.validate resource)
        (let is-text (or (Strings.starts resource.mime "text/")
          (in (extension path) (list ".lisp" ".js" ".mjs" ".json" ".txt" ".md" ".svg" ".wgsl"))))
        (if is-text (Resources.text resource))
        (__write__ entries contents ops path resource is-text 0)
      })
      (insert imported path)
    })
    (return imported)
  }))))
(let exportFiles (async (fn (fs path)
  (await fs.__tail__)
  (set path (normalize path))
  (let selected (stat fs path))
  (Resources.require selected $"Path does not exist: {path}")
  (let base (if (= path "/") "files" selected.name))
  (let result (list))
  (for current (Strings.sorted (keys fs.entries)) {
    (if (not (contains path current)) (continue))
    (let entry (get fs.entries.(get current)))
    (let suffix (if (= path "/") (if (= current "/") "" current) (Strings.slice current (len path) nil)))
    (insert result (dict "path" $"{base}{suffix}" "kind" entry.kind "modified" entry.modified
      "resource" (get fs.__contents__.(get current))))
  })
  result)))
(let install (fn (fs files backup)
  (__mutate__ fs (fn (entries contents ops) {
    (let updated (list))
    (if backup {
      (Resources.require (and (contains "/editor/backups" backup) (not (in backup entries))) "Invalid backup directory")
      (__ensure__ entries ops backup)
      (for path (keys entries) {
        (if (or (not (contains "/editor" path)) (= path "/editor") (contains "/editor/backups" path)) (continue))
        (let next $"{backup}{(Strings.slice path 7 nil)}")
        (let entry (copy (get entries.(get path))))
        (set entry.path next) (set entry.name (name next)) (put entries next entry)
        (if (= entry.kind "file") {
          (let resource (get contents.(get path))) (put contents next resource) (__put-op__ ops $"file:{next}" resource)
        })
      })
      (for path (keys entries) {
        (if (or (not (contains "/editor" path)) (= path "/editor") (contains "/editor/backups" path)) (continue))
        (remove-key entries path) (remove-key contents path) (__remove-op__ ops $"file:{path}")
      })
    })
    (__ensure__ entries ops "/editor") (__ensure__ entries ops "/project")
    (for file files {
      (set file.path (normalize file.path))
      (if (= file.kind "directory") { (__ensure__ entries ops file.path) (continue) })
      (__ensure__ entries ops (parent file.path))
      (let resource file.resource)
      (if (and file.text (contains "/editor" file.path))
        (set resource (Resources.fromText (Strings.replace (Resources.text resource) "\"../hg/ui.lisp\"" "\"./ui.lisp\"") resource.mime)))
      (__write__ entries contents ops file.path resource file.text nil)
      (insert updated file.path)
    }) (return (dict "updated" updated "backup" backup))
  }))))
(let setProject (fn (fs metadata)
  (promise (__mutate__ fs (fn (entries contents ops) {
    (__put-op__ ops "project" metadata) (return metadata)
  })) then (result) { (set fs.project result) result })))
(let replace (fn (fs entries contents metadata)
  (__mutate__ fs (fn (current data ops) {
    ; Preserve the previous working project outside the active filesystem.
    (__put-op__ ops $"history:{(Resources.now)}" (dict "entries" (re-copy current) "contents" (re-copy data) "project" (re-copy fs.project)))
    (for path (keys current) { (remove-key current path) (__remove-op__ ops $"file:{path}") })
    (for path (keys data) (remove-key data path))
    (for path (keys entries) (put current path (get entries.(get path))))
    (for path (keys contents) {
      (put data path (get contents.(get path))) (__put-op__ ops $"file:{path}" (get contents.(get path)))
    })
    (set metadata.generation (+ fs.version 1))
    (__put-op__ ops "project" metadata) (return metadata)
  }))))
(let FileSystem (dict "new" new "normalize" normalize "parent" parent "name" name "extension" extension
  "contains" contains "rebase" rebase "join" join "stat" stat "list" listFiles
  "readText" readText "readBytes" readBytes "writeText" writeText "writeBytes" writeBytes
  "mkdir" mkdir "remove" removeFile "removeTree" removeTree "move" move "refresh" refresh
  "url" url "ownsURL" ownsURL "fetch" fetch "importFiles" importFiles "exportFiles" exportFiles
  "install" install "replace" replace "setProject" setProject))
