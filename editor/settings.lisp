; Project configuration has one durable apply operation; inputs remain drafts until it succeeds.
(let Ui (await (import "../hg/ui.lisp")))
(let Theme Ui.ui-theme-data)
(let ProjectModule (await (import "./project.lisp")))
(let Project ProjectModule.Project)

(let __toggles__ (fn (node)
  (set node.state.smoothing.props.value (if node.state.options.is "Image smoothing: on" "Image smoothing: off"))
  (set node.state.tracing.props.value (if (= node.state.options.trace nil) "Execution tracing: inherit"
    (if node.state.options.trace "Execution tracing: on" "Execution tracing: off")))))

(let __reset__ (fn (ui node)
  (set node.state.entry.props.value (or app.filesystem.project.entry "/project/main.lisp"))
  (set node.state.options (Project.appOptions app.filesystem.project.app))
  (for key (keys node.state.numbers) {
    (let value (get node.state.options.(get key)))
    (set (get node.state.numbers.(get key)).props.value (if (= value nil) "" (str value)))
  })
  (__toggles__ node)
  (set node.state.status.props.value "")
  (Ui.ui-invalidate ui)))
(let settings-component (dict
  "measure" Ui.ui-container-component.measure "arrange" Ui.ui-container-component.arrange
  "paint" Ui.ui-container-component.paint "mount" __reset__))
(let settings-view (fn (save)
  (let node (Ui.ui-node settings-component (dict "axis" "y" "grow" 1 "gap" 8 "padding" 0)))
  (set node.state.busy false)
  (set node.state.entry (Ui.ui-textbox "" (Ui.grow 0)))
  (set node.state.numbers (dict))
  (for key (list "w" "h" "si" "ups")
    (put node.state.numbers key (Ui.ui-textbox "" (Ui.grow 0))))
  (set node.state.smoothing (Ui.ui-button "" (Ui.ui-on "click" (fn (event)
    (set node.state.options.is (not node.state.options.is))
    (__toggles__ node) (Ui.ui-invalidate event.ui)))))
  (set node.state.tracing (Ui.ui-button "" (Ui.ui-on "click" (fn (event)
    (set node.state.options.trace (if (= node.state.options.trace nil) true (if node.state.options.trace false nil)))
    (__toggles__ node) (Ui.ui-invalidate event.ui)))))
  (set node.state.status (Ui.ui-label "" (Ui.size Theme.small-size)))
  (let busy (fn (value)
    (set node.state.busy value)
    (for control (list node.state.entry node.state.apply node.state.revert node.state.smoothing node.state.tracing)
      (set control.props.disabled value))
    (for key (keys node.state.numbers) (set (get node.state.numbers.(get key)).props.disabled value))))
  (let apply (fn (ui)
    (if node.state.busy (return false))
    (let entry node.state.entry.props.value)
    (busy true)
    (set node.state.status.props.value "Saving...")
    (Ui.ui-invalidate ui)
    (promise {
      (let options (copy node.state.options))
      (for key (keys node.state.numbers) {
        (let source (get node.state.numbers.(get key)).props.value)
        (put options key (if (= source "") nil (num source)))
      })
      (await (save (dict "entry" entry "app" options)))
    }
      then () {
        (__reset__ ui node)
        (set node.state.status.props.value "Settings saved.")
        (set node.state.status.props.color Theme.green)
        true
      } catch (error) {
        (set node.state.status.props.value error.message)
        (set node.state.status.props.color Theme.pink)
        false
      } finally { (busy false) (Ui.ui-invalidate ui) })))
  (set node.state.apply (Ui.ui-button "Save settings" (Ui.ui-on "click" (fn (event) (apply event.ui)))))
  (set node.state.revert (Ui.ui-button "Revert" (Ui.ui-on "click" (fn (event)
    (if (not node.state.busy) (__reset__ event.ui node))))))
  (set node.children (list
    (Ui.ui-scroll (Ui.ui-prop "scroll-x" true)
      (Ui.ui-label "App display" (Ui.size Theme.heading-size))
      (Ui.ui-hbox (Ui.gap 12)
        (Ui.ui-vbox (Ui.grow 1) (Ui.ui-label "Width (pixels)") node.state.numbers.w)
        (Ui.ui-vbox (Ui.grow 1) (Ui.ui-label "Height (pixels)") node.state.numbers.h))
      (Ui.ui-label "Blank dimensions follow the Game pane size." (Ui.size Theme.small-size))
      (Ui.ui-hbox (Ui.gap 12)
        (Ui.ui-vbox (Ui.grow 1) (Ui.ui-label "Scale increment") node.state.numbers.si)
        (Ui.ui-vbox (Ui.grow 1) (Ui.ui-label "Updates per second") node.state.numbers.ups))
      (Ui.ui-label "Blank or 0 scale: continuous fit. Use 1 for integer scaling." (Ui.size Theme.small-size))
      (Ui.ui-hbox (Ui.gap 8) node.state.smoothing node.state.tracing)
      (Ui.ui-label "Project files" (Ui.size Theme.heading-size))
      (Ui.ui-label "Entry file")
      node.state.entry
      (Ui.ui-label "The file run in the Game pane." (Ui.size Theme.small-size))
      (Ui.ui-label "Missing files are loaded from local server paths." (Ui.size Theme.small-size)))
    (Ui.ui-bar node.state.apply node.state.revert)
    (Ui.ui-scroll (Ui.height 64) (Ui.grow 0) (Ui.ui-prop "scroll-x" true) node.state.status)))
  node))
