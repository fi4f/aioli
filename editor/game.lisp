; A dockable project runtime. Live handles stay in component state, outside saved data.
(let Ui (await (import "../hg/ui.lisp")))
(let Theme Ui.ui-theme-data)
(let ProjectModule (await (import "./project.lisp")))
(let Project ProjectModule.Project)

(let reload (async (fn (ui node restart)
  (if (or (not node.state.mounted) node.state.loading) (return false))
  (let generation node.state.generation)
  (set app.state.editor.need-game-reload false)
  (set node.state.loading true) (set node.state.error "")
  (promise {
    (let options (Project.appOptions app.filesystem.project.app))
    (let child node.state.child)
    (if (or (= child nil) restart) {
      (if child (App.dispose child))
      (if restart (set app.state.project (dict)))
      (if (= app.state.project nil) (set app.state.project (dict)))
      (set child (App.embed app options))
      (set child.state app.state.project)
      (set node.state.child child) (set node.state.view.props.app child)
      (if node.props.settings.paused (App.pause child))
      (Ui.ui-invalidate ui)
    })
    (set child.w options.w) (set child.h options.h) (set child.si options.si)
    (set child.is options.is) (set child.ups options.ups)
    (set child.trace (if (= options.trace nil) app.trace options.trace))
    (let entry (or app.filesystem.project.entry "/project/main.lisp"))
    (if child.sourceURL (await (App.reloadModules child (fs-url entry)))
      else (await (App.load child (fs-url entry))))
    (if (= generation node.state.generation) { (set node.state.error "") (set child.error "") })
    true
  } catch (error) {
    (if (= generation node.state.generation) (set node.state.error error.message))
    false
  } finally {
    (if (= generation node.state.generation) { (set node.state.loading false) (Ui.ui-invalidate ui) })
  }))))
(let __tick__ (fn (ui node context)
  (let child node.state.child)
  (if child (set node.props.settings.paused child.paused))
  (if (and child child.failed) (set node.state.error child.error))
  (let key (list node.state.loading node.state.error node.props.settings.paused))
  (if (= key node.state.status-key) (return))
  (set node.state.status-key key)
  (set node.state.status.props.value (if node.state.loading "Loading game..."
    (if node.state.error "Game error" (if node.props.settings.paused "Paused" "Running"))))
  (set node.state.pause-label.props.value (if node.props.settings.paused "Resume" "Pause"))
  (set node.state.error-label.props.value node.state.error)
  (set node.state.error-box.props.visible (bool node.state.error))
  (Ui.ui-invalidate ui)))
(let game-component (dict
  "measure" Ui.ui-container-component.measure "arrange" Ui.ui-container-component.arrange
  "paint" Ui.ui-container-component.paint "tick" __tick__
  "mount" (fn (ui node)
    (set node.state.generation (+ (or node.state.generation 0) 1))
    (set node.state.loading false) (set node.state.error "")
    (reload ui node false))
  "unmount" (fn (ui node)
    (set node.state.generation (+ node.state.generation 1))
    (if node.state.child (App.dispose node.state.child))
    (set node.state.child nil) (set node.state.view.props.app nil))))
(let game-view (fn (settings flush)
  (let node (Ui.ui-node game-component (dict "axis" "y" "gap" 4 "padding" 0 "grow" 1 "settings" settings)))
  (set node.state.view (Ui.ui-app nil))
  (set node.state.status (Ui.ui-label "Loading game..." (Ui.size Theme.small-size)))
  (set node.state.pause-label (Ui.ui-label "Pause"))
  (set node.state.error-label (Ui.ui-label "" (Ui.fill Theme.pink) (Ui.size Theme.small-size)))
  (set node.state.error-box (Ui.ui-scroll (Ui.height 90) (Ui.grow 0) (Ui.visible false)
    (Ui.ui-prop "scroll-x" true) node.state.error-label))
  (let load (async (fn (ui restart)
    (if (await (flush)) (await (reload ui node restart))))))
  (set node.children (list
    (Ui.ui-bar (Ui.gap 4)
      (Ui.ui-button "Reload game" (Ui.ui-on "click" (fn (event) (load event.ui false))))
      (Ui.ui-button "Restart game" (Ui.ui-on "click" (fn (event) (load event.ui true))))
      (Ui.ui-button node.state.pause-label (Ui.ui-on "click" (fn (event)
        (set settings.paused (not (if node.state.child node.state.child.paused settings.paused)))
        (if node.state.child
          (if settings.paused (App.pause node.state.child) else (App.start node.state.child)))
      ))))
    node.state.status node.state.error-box node.state.view))
  node))
