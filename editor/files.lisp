; The filesystem pane, tree, prompts, and previews are ordinary editable Lisp.
(let Ui (await (import "../hg/ui.lisp")))
(let Theme Ui.ui-theme-data)

(let __tree-measure__ (fn (ui node)
  (let model node.props.model)
  (let files model.files)
  (let key (list app.filesystem.version files.selected (re-copy files.expanded) files.busy model.switching model.reloading))
  (if (not (= key node.state.key)) {
    (if (and ui.focus (Ui.ui-path node ui.focus)) (Ui.ui-focus ui (list)))
    (set node.children (list))
    (let visit (fn (entry depth)
      (let folder (= entry.kind "directory"))
      (let expanded (get files.expanded.(get entry.path)))
      (let icons (if folder (list (if expanded Theme.icons.chevron-d Theme.icons.chevron-r) Theme.icons.folder)
        (list (if (= (Vfs.extension entry.path) ".lisp") Theme.icons.code
          (if entry.image Theme.icons.image Theme.icons.file)))))
      (let content (Ui.ui-hbox (Ui.gap 4) (Ui.v-align "center")))
      (for icon icons (insert content.children (Ui.ui-icon icon (Ui.size Theme.icon-size) (Ui.fill Theme.foreground))))
      (insert content.children (Ui.ui-label entry.name (Ui.font Theme.font) (Ui.size Theme.size) (Ui.fill Theme.foreground)))
      (let row (Ui.ui-button content (Ui.height 28)
        (Ui.padding (vec2 (+ 5 (* depth 14)) 3))
        (Ui.h-align "left")
        (Ui.disabled (bool (or files.busy model.switching model.reloading)))
        (Ui.background (if (= files.selected entry.path) Theme.border Theme.surface))
        (Ui.ui-prop "hover" Theme.raised)
        (Ui.ui-prop "pressed" Theme.border)
        (Ui.ui-prop "focus-color" Theme.green)
        (Ui.ui-prop "border-width" Theme.border-width)
        (Ui.ui-on "pointerdown" (fn (event)
          (if (= event.button 2) (node.props.owner.state.context event entry))))
        (Ui.ui-on "click" (fn (event) {
          (if (or files.busy model.switching model.reloading) (return))
          (set files.selected entry.path)
          (set files.error "")
          (if folder (put files.expanded entry.path (not (get files.expanded.(get entry.path))))
            else (Ui.ui-event ui node.props.owner "open" (dict "path" entry.path)))
        }))))
      (insert node.children row)
      (if (and folder expanded) (for child (fs-list entry.path) (visit child (+ depth 1))))))
    (visit (fs-stat "/") 0)
    (set node.state.key key)
  })
  (for child node.children (Ui.ui-measure ui child))
  (vec2 220 100)))
(let __tree-arrange__ (fn (ui node)
  (set node.state.max-scroll (max 0 (- (* (len node.children) 28) node.bounds.w)))
  (set node.props.model.files.scroll (clamp node.props.model.files.scroll 0 node.state.max-scroll))
  (let y (- node.bounds.y node.props.model.files.scroll))
  (for child node.children {
    (Ui.ui-arrange ui child (vec4 node.bounds.x y node.bounds.z 28) node.clip)
    (set y (+ y 28))
  })))
(let __tree-event__ (fn (ui node name event)
  (if (= name "wheel") {
    (let delta event.dy)
    (if (= event.mode 1) (set delta (* delta 28)))
    (if (= event.mode 2) (set delta (* delta node.bounds.w)))
    (set node.props.model.files.scroll (clamp (+ node.props.model.files.scroll delta) 0 node.state.max-scroll))
    (__tree-arrange__ ui node)
    (Ui.ui-repaint ui)
    (set event.stop true) (set event.prevent-default true)
  })))
(let __tree-component__ (dict "measure" __tree-measure__ "arrange" __tree-arrange__ "event" __tree-event__))

(let __directory__ (fn (files)
  (let selected (fs-stat files.selected))
  (if (and selected (= selected.kind "directory")) (return selected.path))
  (if selected (return (fs-parent selected.path)))
  "/project"))
(let __action__ (async (fn (ui node)
  (let model node.props.model)
  (let files model.files)
  (if (or files.busy model.switching model.reloading) (return false))
  (set files.busy true)
  (set files.error "")
  (Ui.ui-invalidate ui)
  (promise {
    (if (not (await (node.props.flush))) { (set files.busy false) (return false) })
    (let path (fs-join (__directory__ files) node.state.input.props.value))
    (if (= files.mode "rename") {
      (let previous files.selected)
      (set path (fs-join (fs-parent previous) node.state.input.props.value))
      (await (fs-move previous path))
      (let expanded (dict))
      (for directory (keys files.expanded)
        (put expanded (fs-rebase directory previous path) (get files.expanded.(get directory))))
      (set files.expanded expanded)
      (Ui.ui-event ui node "move" (dict "from" previous "to" path))
    } elif (= files.mode "folder") (await (fs-mkdir path))
      else (await (fs-write-text path "" 0)))
    (set files.selected path)
    (put files.expanded (fs-parent path) true)
    (set files.mode "")
    (set node.state.input.props.value "")
    (set files.busy false)
    (Ui.ui-invalidate ui)
    (if (not (= (fs-stat path).kind "directory")) (Ui.ui-event ui node "open" (dict "path" path)))
    true
  } catch (error) {
    (set files.error error.message) (set files.busy false) (Ui.ui-invalidate ui) false
  }))))
(let __delete__ (async (fn (ui node)
  (let files node.props.model.files)
  (if (or files.busy node.props.model.switching node.props.model.reloading) (return false))
  (let path files.confirm-delete)
  (set files.busy true)
  (Ui.ui-invalidate ui)
  (promise {
    (if (not (await (node.props.flush))) { (set files.busy false) (return false) })
    (await (fs-remove-tree path))
    (set files.confirm-delete "")
    (set files.selected (fs-parent path))
    (set files.busy false)
    (Ui.ui-event ui node "remove" (dict "path" path))
    (Ui.ui-invalidate ui)
    true
  } catch (error) {
    (set files.error error.message) (set files.busy false) (Ui.ui-invalidate ui) false
  }))))
(let __import__ (fn (ui node directory folder)
  (let model node.props.model) (let files model.files)
  (if (or files.busy model.switching model.reloading) (return false))
  (set files.busy true) (set files.error "")
  ; Open the native picker during the click, before any asynchronous save.
  (let selection (Resources.openFiles folder))
  (Ui.ui-invalidate ui)
  (promise {
    (let selected (await selection))
    (if (or (= selected nil) (= (len selected) 0)) (return false))
    (if app.destroyed (return false))
    (if (not (await (node.props.flush))) (return false))
    (if app.destroyed (return false))
    (let paths (await (Vfs.importFiles app.filesystem directory selected)))
    (let first (get selected.0))
    (set files.selected (fs-join directory (get (Strings.split first.path "/").0)))
    (put files.expanded directory true)
    (put files.expanded files.selected true)
    (Ui.ui-event ui node "import" (dict "paths" paths))
    true
  } catch (error) { (set files.error error.message) false }
    finally { (set files.busy false) (Ui.ui-invalidate ui) })))
(let __export__ (fn (ui node path)
  (let model node.props.model) (let files model.files)
  (if (or files.busy model.switching model.reloading) (return false))
  (set files.busy true) (set files.error "")
  (Ui.ui-invalidate ui)
  (promise {
    (if (not (await (node.props.flush))) (return false))
    (if app.destroyed (return false))
    (let entries (await (Vfs.exportFiles app.filesystem path)))
    (let first (get entries.0))
    (if (= first.kind "file") (Resources.downloadFile first.path first.resource)
      else (Resources.downloadArchive $"{first.path}.zip" entries))
    true
  } catch (error) { (set files.error error.message) false }
    finally { (set files.busy false) (Ui.ui-invalidate ui) })))
(let __pane-tick__ (fn (ui node context)
  (let files node.props.model.files)
  (let key (list app.filesystem.version files.selected files.mode files.busy node.props.model.switching node.props.model.reloading files.confirm-delete files.error))
  (if (= key node.state.key) (return))
  (set node.state.key key)
  (set node.state.selected.props.value files.selected)
  (set node.state.prompt.props.visible (not (= files.mode "")))
  (set node.state.caption.props.value (if (= files.mode "rename") $"Rename {files.selected}"
    (if (= files.mode "folder") $"New folder in {(__directory__ files)}" $"New file in {(__directory__ files)}")))
  (set node.state.confirm.props.visible (not (= files.confirm-delete "")))
  (set node.state.confirm-label.props.value $"Delete {files.confirm-delete} and its contents?")
  (set node.state.error.props.value files.error)
  (set node.state.error.props.color Theme.pink)
  (set node.state.error.props.visible (not (= files.error "")))
  (let busy (bool (or files.busy node.props.model.switching node.props.model.reloading)))
  (set node.state.submit.props.disabled busy)
  (set node.state.input.props.disabled busy)
  (Ui.ui-invalidate ui)))
(let __pane-component__ (dict "measure" Ui.ui-container-component.measure
  "arrange" Ui.ui-container-component.arrange "paint" Ui.ui-container-component.paint "tick" __pane-tick__))

(let files-pane (fn (model flush &rest options)
  (if (= model.files nil) (set model.files (dict "selected" "/project" "scroll" 0 "expanded"
    (dict) "mode" "" "busy" false "confirm-delete" "" "error" "")))
  (let files model.files)
  (let node (Ui.ui-node __pane-component__ (dict "axis" "y" "padding" 0 "gap" 4 "grow" 1 "model" model "flush" flush) options))
  (if (= (get files.expanded."/") nil) (put files.expanded "/" true))
  (let begin (fn (mode)
    (if (or files.busy model.switching model.reloading) (return))
    (if (and (= mode "rename") (or (= files.selected "/") (= (fs-stat files.selected) nil))) (return))
    (set files.mode mode) (set files.error "")
    (set node.state.input.props.value (if (= mode "rename") (fs-name files.selected) ""))
  ))
  (let request-delete (fn ()
    (if (and (not files.busy) (not model.switching) (not model.reloading)
      (not (= files.selected "/")) (fs-stat files.selected))
      (set files.confirm-delete files.selected))))
  (set node.state.context (fn (event entry)
    (if (or files.busy model.switching model.reloading) (return))
    (set files.selected entry.path)
    (set files.error "")
    (let item (fn (title action)
      (Ui.ui-button
        (Ui.ui-label title (Ui.font Theme.font) (Ui.size Theme.size) (Ui.fill Theme.foreground))
        (Ui.h-align "left")
        (Ui.background Theme.raised)
        (Ui.ui-prop "hover" Theme.border)
        (Ui.ui-prop "pressed" Theme.surface)
        (Ui.ui-prop "focus-color" Theme.green)
        (Ui.ui-prop "border-width" Theme.border-width)
        (Ui.ui-on "click" (fn (event)
          (if (or files.busy model.switching model.reloading) (return))
          (action event))))))
    (let folder (= entry.kind "directory"))
    (let popup (Ui.ui-vbox (Ui.padding 6) (Ui.gap 2) (Ui.background Theme.surface)
      (item (if folder (if (get files.expanded.(get entry.path)) "Collapse" "Expand") "Open")
        (fn (event)
          (if folder (put files.expanded entry.path (not (get files.expanded.(get entry.path))))
            else (Ui.ui-event event.ui node "open" (dict "path" entry.path)))))
      (item "New file" (fn () (begin "file")))
      (item "New folder" (fn () (begin "folder")))
      (if folder (list
        (item "Import files" (fn (event) (__import__ event.ui node entry.path false)))
        (item "Import folder" (fn (event) (__import__ event.ui node entry.path true)))))
      (item "Export" (fn (event) (__export__ event.ui node entry.path)))
      (if (not (= entry.path "/")) (list
        (item "Rename" (fn () (begin "rename")))
        (item "Delete" (fn () (request-delete)))))))
    (Ui.ui-open-popup event.ui popup (dict "bounds" (vec4 event.x event.y 0 0)))
    (set event.stop true)
    (set event.prevent-default true)))
  (let toolbar (Ui.ui-bar (Ui.padding 2)
    (Ui.height 38)
    (Ui.ui-button "File +" (Ui.ui-on "click" (fn () (begin "file"))))
    (Ui.ui-button "Folder +" (Ui.ui-on "click" (fn () (begin "folder"))))
    (Ui.ui-button "Rename" (Ui.ui-on "click" (fn () (begin "rename"))))
    (Ui.ui-button "Delete" (Ui.ui-on "click" (fn () (request-delete))))
    (Ui.ui-dropdown "Import"
      (Ui.ui-button "Import files" (Ui.ui-on "click" (fn (event) (__import__ event.ui node "/" false))))
      (Ui.ui-button "Import folder" (Ui.ui-on "click" (fn (event) (__import__ event.ui node "/" true)))))
    (Ui.ui-button "Export" (Ui.ui-on "click" (fn (event) (__export__ event.ui node files.selected))))))
  (set node.state.selected (Ui.ui-label files.selected (Ui.size Theme.small-size)))
  (set node.state.caption (Ui.ui-label "" (Ui.size Theme.small-size)))
  (set node.state.input (Ui.ui-textbox "" (Ui.ui-on "submit" (fn (event) (__action__ event.ui node)))))
  (set node.state.submit (Ui.ui-button "Apply" (Ui.ui-on "click" (fn (event) (__action__ event.ui node)))))
  (set node.state.prompt (Ui.ui-vbox (Ui.visible false)
    (Ui.gap 3)
    node.state.caption (Ui.ui-hbox node.state.input node.state.submit)
    (Ui.ui-button "Cancel" (Ui.ui-on "click" (fn () (set files.mode ""))))))
  (set node.state.confirm-label (Ui.ui-label "" (Ui.size Theme.small-size)))
  (set node.state.confirm (Ui.ui-vbox (Ui.visible false)
    (Ui.gap 3)
    node.state.confirm-label
    (Ui.ui-hbox (Ui.ui-button "Delete contents" (Ui.ui-on "click" (fn (event) (__delete__ event.ui node))))
      (Ui.ui-button "Cancel" (Ui.ui-on "click" (fn () (set files.confirm-delete "")))))))
  (set node.state.error (Ui.ui-label "" (Ui.fill Theme.pink)
    (Ui.size Theme.small-size)
    (Ui.visible false)))
  (insert node.children toolbar)
  (insert node.children node.state.selected)
  (insert node.children node.state.prompt)
  (insert node.children node.state.confirm)
  (insert node.children node.state.error)
  (insert node.children (Ui.ui-node __tree-component__ (dict "grow" 1 "model" model "owner" node)))
  node))

(let __preview-checker__ (sh (bounds:vec4 cell:f32 light:vec4 dark:vec4)
  (let p (vec2i (/ (- xy bounds.xy) cell)))
  (if (< (% (+ p.x p.y) 2:i) 1:i) (return light))
  dark))
(let __preview-shader__ (sh (image:texture2d bounds:vec4 clip:vec4)
  (if (and (>= xy.x bounds.x) (>= xy.y bounds.y) (< xy.x (+ bounds.x bounds.z)) (< xy.y (+ bounds.y bounds.w))
    (>= xy.x clip.x) (>= xy.y clip.y) (< xy.x (+ clip.x clip.z)) (< xy.y (+ clip.y clip.w)))
    (return (sample-nearest image (/ (- xy bounds.xy) bounds.zw))))
  (vec4)))
(let __preview-scale__ (fn (ui node)
  (let view node.props.model)
  (let image view.image)
  (if view.fit (return (min
    (/ (max 1 (- node.bounds.z 16)) image.w) (/ (max 1 (- node.bounds.w 16)) image.h))))
  (/ view.zoom ui.scale)))
(let __preview-event__ (fn (ui node name event)
  (let view node.props.model)
  (if (= view.image nil) (return))
  (if (and (= name "pointerdown") (= event.button 0)) {
    (set node.state.drag (dict "id" event.id "point" (vec2 event.x event.y) "pan" (copy view.pan)))
    (set node.props.cursor "grabbing")
    (set event.stop true) (set event.prevent-default true)
  })
  (if (and node.state.drag (= event.id node.state.drag.id)) {
    (if (= name "pointermove") {
      (set view.pan (+ node.state.drag.pan (- (vec2 event.x event.y) node.state.drag.point)))
      (Ui.ui-repaint ui)
      (set event.stop true) (set event.prevent-default true)
    })
    (if (or (= name "pointerup") (= name "pointercancel")) {
      (set node.state.drag nil) (set node.props.cursor "grab")
      (set event.stop true) (set event.prevent-default true)
    })
  })
  (if (= name "wheel") {
    (let delta event.dy)
    (if (= event.mode 1) (set delta (* delta 20)))
    (if (= event.mode 2) (set delta (* delta node.bounds.w)))
    (set delta (clamp delta -600 600))
    (let factor (__preview-scale__ ui node))
    (let zoom (clamp (* factor ui.scale
      (if (< delta 0) (+ 1 (* (- delta) 0.002)) (/ 1 (+ 1 (* delta 0.002))))) 0.01 64))
    (let point (- (vec2 event.x event.y) (+ node.bounds.xy (/ node.bounds.zw 2))))
    (set view.pan (- point (* (- point view.pan) (/ zoom (* factor ui.scale)))))
    (set view.zoom zoom) (set view.fit false)
    (set node.state.drag nil) (set node.props.cursor "grab")
    (Ui.ui-repaint ui)
    (set event.stop true) (set event.prevent-default true)
  })))
(let __preview-component__ (dict "measure" (fn () (vec2 100 100))
  "event" __preview-event__
  "unmount" (fn (ui node) (set node.state.drag nil))
  "paint" (fn (ui node context) {
    (layer context (* node.clip ui.scale) __preview-checker__ (* node.bounds ui.scale)
      (* Theme.preview-checker-size ui.scale) Theme.preview-checker-light Theme.preview-checker-dark)
    (let view node.props.model)
    (let image view.image)
    (if (= image nil) (return))
    (let factor (__preview-scale__ ui node))
    (let size (* (vec2 image.w image.h) factor))
    (let origin (+ node.bounds.xy (/ (- node.bounds.zw size) 2) view.pan))
    (set origin (/ (Ui.ui-pixel-position (* origin ui.scale)) ui.scale))
    (let bounds (vec4 origin size))
    (layer context (* (Ui.ui-intersect bounds node.clip) ui.scale) __preview-shader__ image (* bounds ui.scale) (* node.clip ui.scale))
  })))
(let file-preview (fn (view)
  (Ui.ui-node __preview-component__ (dict "model" view "grow" 1 "focusable" true "cursor" "grab"))))
