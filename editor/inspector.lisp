; Read live binding values only along expanded paths. Expansion state is plain data.
(let Ui (await (import "../hg/ui.lisp")))
(let Theme (await (import "./theme.lisp")))
(let __page-size__ 50)
(let __row-limit__ 300)
(let __depth-limit__ 16)

(let __rows__ (fn (model)
  (let rows (list))
  (let handles (App.inspect app))
  (let visit (fn (name reference path depth parent)
    (if (>= (len rows) __row-limit__) (return))
    (let key (to-json (list reference.name path)))
    (let page (max 0 (or (get model.pages.(get key)) 0)))
    (let value (App.preview app reference path __page-size__ (* page __page-size__)))
    (if (and (> page 0) (>= (* page __page-size__) value.count)) {
      (set page 0) (put model.pages key 0)
      (set value (App.preview app reference path __page-size__ 0))
    })
    (let expandable (and (> value.count 0) (not value.circular)))
    (let expanded (and expandable (bool (get model.expanded.(get key)))))
    (let caption $"{name}: {value.preview}")
    (if (> (len caption) 240) (set caption $"{(Strings.slice caption 0 240)}…"))
    (insert rows (dict "key" key "parent" parent "text" caption "depth" depth
      "expandable" expandable "expanded" expanded "index" (len rows)))
    (if (not expanded) (return))
    (if (>= depth __depth-limit__) {
      (insert rows (dict "key" $"{key}:depth" "text" "Maximum preview depth reached"
        "depth" (+ depth 1) "parent" key "index" (len rows)))
      (return)
    })
    (for child value.keys {
      (if (>= (len rows) __row-limit__) (break))
      (let next (copy path)) (insert next child)
      (visit (if (str? child) (to-json child) (str child)) reference next (+ depth 1) key)
    })
    (if (and (> page 0) (< (len rows) __row-limit__))
      (insert rows (dict "key" $"{key}:previous" "parent" key "page" (- page 1)
        "text" "Previous 50 entries" "depth" (+ depth 1) "index" (len rows))))
    (if (and (< (* (+ page 1) __page-size__) value.count) (< (len rows) __row-limit__))
      (insert rows (dict "key" $"{key}:next" "parent" key "page" (+ page 1)
        "text" $"Next 50 entries ({(min (* (+ page 1) __page-size__) value.count)} of {value.count} shown)"
        "depth" (+ depth 1) "index" (len rows))))
  ))
  (for name (Strings.sorted (keys handles))
    (visit name (get handles.(get name)) (list) 0 ""))
  (if (>= (len rows) __row-limit__)
    (insert rows (dict "key" "limit" "text" "Preview limit reached; collapse other branches."
      "depth" 0 "index" (len rows))))
  rows))

(let __activate__ (fn (ui node entry)
  (if (not (= entry.page nil)) (put node.props.model.pages entry.parent entry.page)
    elif entry.expandable (put node.props.model.expanded entry.key (not entry.expanded))
    else (return))
  (refresh ui node)))

(let __keydown__ (fn (ui node entry event)
  (let index entry.index)
  (if (or (= event.code "ArrowDown") (= event.code "ArrowUp")) {
    (set index (clamp (+ index (if (= event.code "ArrowDown") 1 -1)) 0 (- (len node.children) 1)))
    (Ui.ui-focus ui (Ui.ui-path ui.root (get node.children.(get index))))
  } elif (= event.code "ArrowRight") {
    (if (not entry.expandable) (return))
    (if (not entry.expanded) (__activate__ ui node entry)
      elif (< (+ index 1) (len node.children))
      (Ui.ui-focus ui (Ui.ui-path ui.root (get node.children.(+ index 1)))))
  } elif (= event.code "ArrowLeft") {
    (if entry.expanded (__activate__ ui node entry)
      elif (get node.state.nodes.(get entry.parent))
      (Ui.ui-focus ui (Ui.ui-path ui.root (get node.state.nodes.(get entry.parent))))
      else (return))
  } else (return))
  (set event.prevent-default true) (set event.stop true)))

(let __row__ (fn (owner)
  (let marker (Ui.ui-icon Theme.icons.chevron-r (Ui.size Theme.icon-size) (Ui.fill Theme.foreground)))
  (let label (Ui.ui-label "" (Ui.font Theme.font) (Ui.size Theme.size) (Ui.fill Theme.foreground)))
  (let row (Ui.ui-button
    (Ui.ui-box (Ui.width Theme.icon-size) (Ui.height Theme.icon-size) marker) label
    (Ui.height 24) (Ui.h-align "left")
    (Ui.background Theme.surface) (Ui.ui-prop "hover" Theme.raised)
    (Ui.ui-prop "pressed" Theme.border) (Ui.ui-prop "focus-color" Theme.green)
    (Ui.ui-prop "border-width" Theme.border-width)
    (Ui.ui-on "click" (fn (event) (__activate__ event.ui owner event.current-target.props.entry)))
    (Ui.ui-on "keydown" (fn (event) (__keydown__ event.ui owner event.current-target.props.entry event)))))
  (set row.state.label label) (set row.state.marker marker)
  row))

(let refresh (fn (ui node)
  (let rows (__rows__ node.props.model))
  (let summary "")
  (for row rows (set summary $"{summary}{row.key}|{row.depth}|{row.expanded}|{row.text}\n"))
  (if (= summary node.props.value) (return))
  (let previous node.state.nodes)
  (let nodes (dict)) (let children (list))
  (for entry rows {
    (let row (or (get previous.(get entry.key)) (__row__ node)))
    (set row.props.entry entry)
    (set row.props.padding (vec2 (+ 4 (* entry.depth 14)) 2))
    (set row.state.label.props.value entry.text)
    (set row.state.marker.props.visible (bool entry.expandable))
    (set row.state.marker.props.source (if entry.expanded Theme.icons.chevron-d Theme.icons.chevron-r))
    (set row.state.marker.state.image row.state.marker.props.source)
    (put nodes entry.key row) (insert children row)
  })
  (if (and ui.focus (Ui.ui-path node ui.focus)
    (not (get nodes.(get ui.focus.props.entry.key)))) (Ui.ui-focus ui (list)))
  (set node.children children) (set node.state.nodes nodes)
  (set node.props.value summary)
  (Ui.ui-invalidate ui)))

(let bindings-pane (fn (model)
  (if (= model.expanded nil) (set model.expanded (dict)))
  (if (= model.pages nil) (set model.pages (dict)))
  (let node (Ui.ui-vbox (Ui.gap 0) (Ui.ui-prop "model" model) (Ui.ui-prop "value" "")))
  (set node.state.nodes (dict))
  node))
