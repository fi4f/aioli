; Editor constants and component styling. Every value remains ordinary, editable Lisp.
(let Ui (await (import "../hg/ui.lisp")))
(let background (vec4 0.153 0.157 0.133 1))
(let surface (vec4 0.122 0.125 0.106 1))
(let raised (vec4 0.20 0.204 0.173 1))
(let foreground (vec4 0.973 0.973 0.949 1))
(let muted (vec4 0.459 0.443 0.369 1))
(let green (vec4 0.651 0.886 0.180 1))
(let pink (vec4 0.976 0.149 0.447 1))
(let orange (vec4 0.992 0.592 0.122 1))
(let purple (vec4 0.682 0.506 1 1))
(let cyan (vec4 0.4 0.851 0.937 1))
(let border (vec4 0.286 0.282 0.243 1))
(let font "monospace")
(let size 13)
(let code-size 14)
(let heading-size 18)
(let small-size 12)
(let text-padding 4)
(let bar-padding 6)
(let line-height 21)
(let border-width 2)
(let icon-size 16)
(let reload-delay 0.4)
(let save-delay 0.4)
(let inspect-delay 0.25)
(let viewport-overscan 2)
(let preview-checker-size 12)
(let preview-checker-light (vec4 0.34 0.34 0.34 1))
(let preview-checker-dark (vec4 0.24 0.24 0.24 1))
(let raster-width-step 256)
(let raster-row-step 8)
(let metrics-probe-count 100)
(let dock (dict "divider" 0 "dwell" 0.6 "dwell-delay" 0.15 "dwell-decay" 0.2 "hold-radius" 6
  "drag-threshold" 6 "undock-shrink" 32 "undock-shrink-bottom" 64))
(let palette (dict
  "plain" foreground.xyz "punctuation" muted.xyz "keyword" pink.xyz "type" cyan.xyz
  "builtin" cyan.xyz "function" green.xyz "operator" pink.xyz "literal" purple.xyz
  "number" purple.xyz "string" (vec3 0.902 0.859 0.455) "comment" muted.xyz))
(let selection (vec4 0.4 0.851 0.937 0.24))
(let gutter muted.xyz)
(let icons (dict))
(let icon-loads (list))
(for name (list "handle" "x" "_" "code" "generator" "command" "file" "main" "play"
  "chevron-d" "chevron-l" "chevron-r" "folder" "image")
  (insert icon-loads (promise (image $"./icons/{name}.png")
    then (texture) (put icons name texture))))
(await (async-all icon-loads))

(let __style__ (fn (node props)
  (for key (keys props)
    (if (not (get node.state.configured.(get key))) (put node.props key (get props.(get key)))))))
(let apply (fn (ui)
  (set ui.background background)
  (let visit (fn (node)
    (if node.props.font {
      (if (not node.state.configured.font) (set node.props.font font))
      (if (not node.state.configured.color) (set node.props.color foreground))
      (if (and (same? node.component Ui.ui-label-component) (not node.state.configured.size))
        (set node.props.size size))
    })
    (if (same? node.component Ui.ui-button-component)
      (__style__ node (dict "background" raised "hover" border "pressed" surface
        "disabled-background" surface "focus-color" green "border-width" border-width)))
    (if (same? node.component Ui.ui-icon-component) {
      (if (not node.state.configured.size) (set node.props.size icon-size))
      (if (not node.state.configured.color) (set node.props.color foreground))
    })
    (if (same? node.component Ui.ui-textbox-component)
      (__style__ node (dict "size" size "background" surface "selection-color" selection
        "focus-color" green "border-width" border-width)))
    (if (same? node.component Ui.ui-scroll-component)
      (__style__ node (dict "scrollbar-track" surface "scrollbar-color" muted "scrollbar-active-color" cyan)))
    (if (same? node.component Ui.ui-pane-component) {
      (__style__ node (dict "background" background "border-width" border-width
        "border-color" border "border-hover-color" cyan "border-active-color" green))
      (let header (get node.children.0))
      (set header.props.background raised)
      (let title node.state.title-content)
      (set title.children.0 (Ui.ui-icon icons.handle))
      (if (and node.state.title-node (not node.state.title-node.state.configured.size))
        (set node.state.title-node.props.size size))
      (let minimize (get header.children.1))
      (set minimize.state.value-label nil)
      (set minimize.children (list (Ui.ui-icon (get icons."_"))))
      (let close (get header.children.2))
      (set close.state.value-label nil)
      (set close.children (list (Ui.ui-icon icons.x)))
    })
    (if (same? node.component Ui.ui-dock-component) {
      (__style__ node dock)
      (__style__ node (dict "background" surface "divider-color" border "divider-hover-color" cyan
        "preview-outline" cyan "preview-fill" (vec4 cyan.xyz 0.25)
        "preview-ready" (vec4 green.xyz 0.3) "preview-ready-outline" green))
    })
    (if (or (same? node.component Ui.ui-strip-component) (same? node.component Ui.ui-taskbar-component)) {
      (__style__ node (dict "background" surface "scroll-indicator-color" foreground
        "scroll-indicator-size" icon-size))
      (set node.overlays (list (Ui.ui-icon icons.chevron-l) (Ui.ui-icon icons.chevron-r)))
    })
    (if (same? node.component Ui.ui-taskbar-component)
      (set node.props.item-style (dict "font" font "size" size "color" foreground
        "background" raised "hover" border "pressed" surface "focus-color" green "border-width" border-width)))
    (if node.state.popup-node {
      (if (not node.state.dropdown-icon) {
        (set node.state.dropdown-icon (Ui.ui-icon icons.chevron-d))
        (insert node.children node.state.dropdown-icon)
      })
      (set node.state.popup-node.props.background surface)
      (visit node.state.popup-node)
    })
    (for child node.children (visit child))
    (for overlay node.overlays (visit overlay))))
  (visit ui.root)
  (Ui.ui-invalidate ui)
  ui))
